# Optional: enables custom /id/name Steam profile URLs.
STEAM_WEB_API_KEY=

# Optional: existing Steam session cookie for private-wishlist experiments.
STEAM_COOKIE=

# Exact browser origin for the web app (no trailing path).
WEB_ORIGIN=http://127.0.0.1:8765

# Optional web/preview diagnostic detail: INFO (default) or DEBUG.
# Set environment variables in the launching shell; .env is not loaded automatically.
STEAM_PRICE_POLISHER_LOG_LEVEL=INFO
